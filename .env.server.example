# TaxData production / Railway variables numunesi.
# Real secretleri Git-e, ZIP-e ve Docker image-a daxil etmeyin.
SPRING_PROFILES_ACTIVE=prod
PORT=8080

SUPABASE_DB_URL=jdbc:postgresql://YOUR_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USER=YOUR_USER
SUPABASE_DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=5

# 32-byte AES key, Base64 encoded. Generate once and keep stable.
# Example generation: openssl rand -base64 32
CLOUD_BACKUP_ENABLED=true
CLOUD_BACKUP_RETENTION_DAYS=3
CLOUD_BACKUP_MAX_VERSIONS=96
CLOUD_BACKUP_MAX_ZIP_BYTES=104857600
CLOUD_BACKUP_AUTO_REPLACE_MINUTES=60

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
APP_ADMIN_WHATSAPP=
APP_WHATSAPP_URL=
APP_ADMIN_SYNC_PASSWORD=true
APP_SESSION_DAYS=7

ETAXES_EXECUTION_MODE=LOCAL_AGENT
ETAXES_OTP_TIMEOUT_SECONDS=180
ETAXES_NAVIGATION_TIMEOUT_SECONDS=60
ETAXES_ELEMENT_TIMEOUT_SECONDS=60
ETAXES_HTTP_TIMEOUT_SECONDS=75
ETAXES_TASK_RETENTION_MINUTES=30
ETAXES_MAX_CONCURRENT_TASKS=3
