# TaxData lokal test ucun numune. Bunu .env kimi kopyalayib oz deyerlerinizi yazin.
SPRING_PROFILES_ACTIVE=dev
PORT=8080
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
APP_ADMIN_SYNC_PASSWORD=true
APP_SESSION_DAYS=7

# Lokal e-Taxes isleri Local Agent ile isleyir.
ETAXES_EXECUTION_MODE=LOCAL_AGENT
ETAXES_BROWSER_HEADLESS=false
ETAXES_BROWSER_SERVER_BUNDLED=false
ETAXES_BROWSER_EXECUTABLE_PATH=
